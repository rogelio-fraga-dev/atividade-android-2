<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_gray"
    tools:context=".TelaPerfil">

    <LinearLayout
        android:id="@+id/toolbar_perfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        android:paddingTop="32dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ic_voltar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Meu Perfil"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/containerUserCard"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="60dp"
        app:cardElevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_perfil">

        <ImageView
            android:id="@+id/img_user_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F0F0F0"
            android:padding="24dp"
            android:src="@drawable/person"
            app:tint="@color/azul_imepac" />
    </androidx.cardview.widget.CardView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardInfo"
        style="@style/ContainerComponents"
        android:layout_marginTop="32dp"
        android:padding="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/containerUserCard">

        <TextView
            android:id="@+id/label_perfil_nome"
            style="@style/FieldLabel"
            android:layout_marginHorizontal="0dp"
            android:layout_marginTop="0dp"
            android:text="NOME COMPLETO"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textNomeUser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Carregando..."
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/label_perfil_nome" />

        <TextView
            android:id="@+id/label_perfil_email"
            style="@style/FieldLabel"
            android:layout_marginHorizontal="0dp"
            android:text="E-MAIL"
            app:layout_constraintTop_toBottomOf="@id/textNomeUser" />

        <TextView
            android:id="@+id/textEmailUser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Carregando..."
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/label_perfil_email" />

        <TextView
            android:id="@+id/label_perfil_cargo"
            style="@style/FieldLabel"
            android:layout_marginHorizontal="0dp"
            android:text="CARGO / FUNÇÃO"
            app:layout_constraintTop_toBottomOf="@id/textEmailUser" />

        <TextView
            android:id="@+id/textCargoUser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Não informado"
            android:textColor="@color/black"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/label_perfil_cargo" />

        <TextView
            android:id="@+id/label_perfil_empresa"
            style="@style/FieldLabel"
            android:layout_marginHorizontal="0dp"
            android:text="EMPRESA / INSTITUIÇÃO"
            app:layout_constraintTop_toBottomOf="@id/textCargoUser" />

        <TextView
            android:id="@+id/textEmpresaUser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="Não informado"
            android:textColor="@color/black"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/label_perfil_empresa" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/bt_sair"
        style="@style/ButtonDanger"
        android:layout_width="match_parent"
        android:layout_marginTop="32dp"
        android:text="Sair da Conta"
        app:layout_constraintTop_toBottomOf="@id/cardInfo" />

</androidx.constraintlayout.widget.ConstraintLayout>