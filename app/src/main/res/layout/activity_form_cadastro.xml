<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <ImageButton
            android:id="@+id/bt_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/title_cadastro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Crie sua conta"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/bt_back" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:layout_constraintTop_toBottomOf="@id/title_cadastro">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Informações Pessoais"
                    android:textColor="@color/azul_imepac"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Nome -->
                <View android:layout_width="match_parent" android:layout_height="12dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edit_text_selector"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/person" app:tint="@color/azul_imepac" />
                    <EditText
                        android:id="@+id/edit_nome"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginStart="12dp"
                        android:background="@android:color/transparent"
                        android:hint="Nome completo"
                        android:inputType="textPersonName"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- E-mail -->
                <View android:layout_width="match_parent" android:layout_height="12dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edit_text_selector"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/email" app:tint="@color/azul_imepac" />
                    <EditText
                        android:id="@+id/edit_email_cadastro"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginStart="12dp"
                        android:background="@android:color/transparent"
                        android:hint="E-mail"
                        android:inputType="textEmailAddress"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Cargo -->
                <View android:layout_width="match_parent" android:layout_height="12dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edit_text_selector"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_edit" app:tint="@color/azul_imepac" />
                    <EditText
                        android:id="@+id/edit_cargo"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginStart="12dp"
                        android:background="@android:color/transparent"
                        android:hint="Cargo / Função"
                        android:inputType="textPersonName"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Empresa -->
                <View android:layout_width="match_parent" android:layout_height="12dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edit_text_selector"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_dashboard" app:tint="@color/azul_imepac" />
                    <EditText
                        android:id="@+id/edit_empresa"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginStart="12dp"
                        android:background="@android:color/transparent"
                        android:hint="Empresa / Instituição"
                        android:inputType="textPersonName"
                        android:textSize="15sp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="24dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Segurança"
                    android:textColor="@color/azul_imepac"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Senha -->
                <View android:layout_width="match_parent" android:layout_height="12dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edit_text_selector"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_edit" app:tint="@color/azul_imepac" />
                    <EditText
                        android:id="@+id/edit_senha_cadastro"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginStart="12dp"
                        android:background="@android:color/transparent"
                        android:hint="Senha (mín. 6 caracteres)"
                        android:inputType="textPassword"
                        android:textSize="15sp" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/bt_cadastrar"
                    style="@style/ButtonCustom"
                    android:layout_width="match_parent"
                    android:layout_marginTop="32dp"
                    android:text="Finalizar Cadastro" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>