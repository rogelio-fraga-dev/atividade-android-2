<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Toolbar -->
        <LinearLayout
            android:id="@+id/toolbar_cadastro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:paddingTop="32dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ic_voltar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Novo Equipamento"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Container card branco com formulário -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/containerForm"
            style="@style/ContainerComponents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:layout_marginTop="24dp"
            android:padding="20dp"
            app:layout_constraintTop_toBottomOf="@id/toolbar_cadastro">

            <TextView
                android:id="@+id/label_nome"
                style="@style/FieldLabel"
                android:layout_marginHorizontal="0dp"
                android:text="Equipamento Eletrônico *"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/edit_nome_eq"
                style="@style/Edit_Text"
                android:layout_marginHorizontal="0dp"
                android:hint="Ex: Notebook Dell, Projetor Epson"
                app:layout_constraintTop_toBottomOf="@id/label_nome" />

            <TextView
                android:id="@+id/label_codigo"
                style="@style/FieldLabel"
                android:layout_marginHorizontal="0dp"
                android:text="Número de Série / Patrimônio *"
                app:layout_constraintTop_toBottomOf="@id/edit_nome_eq" />

            <EditText
                android:id="@+id/edit_codigo_eq"
                style="@style/Edit_Text"
                android:layout_marginHorizontal="0dp"
                android:hint="Ex: EQ-001"
                app:layout_constraintTop_toBottomOf="@id/label_codigo" />

            <TextView
                android:id="@+id/label_setor"
                style="@style/FieldLabel"
                android:layout_marginHorizontal="0dp"
                android:text="Laboratório / Departamento *"
                app:layout_constraintTop_toBottomOf="@id/edit_codigo_eq" />

            <EditText
                android:id="@+id/edit_setor_eq"
                style="@style/Edit_Text"
                android:layout_marginHorizontal="0dp"
                android:hint="Ex: Laboratório de Informática"
                app:layout_constraintTop_toBottomOf="@id/label_setor" />

            <TextView
                android:id="@+id/label_data_compra"
                style="@style/FieldLabel"
                android:layout_marginHorizontal="0dp"
                android:text="Data de Compra"
                app:layout_constraintTop_toBottomOf="@id/edit_setor_eq" />

            <EditText
                android:id="@+id/edit_data_compra"
                style="@style/Edit_Text"
                android:layout_marginHorizontal="0dp"
                android:drawableEnd="@drawable/ic_calendar"
                android:hint="dd/mm/aaaa"
                android:inputType="number"
                app:layout_constraintTop_toBottomOf="@id/label_data_compra" />

            <TextView
                android:id="@+id/label_status"
                style="@style/FieldLabel"
                android:layout_marginHorizontal="0dp"
                android:text="Status Atual *"
                app:layout_constraintTop_toBottomOf="@id/edit_data_compra" />

            <Spinner
                android:id="@+id/spinner_status"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/edit_text_selector"
                app:layout_constraintTop_toBottomOf="@id/label_status" />

            <TextView
                android:id="@+id/label_proxima_manut"
                style="@style/FieldLabel"
                android:layout_marginHorizontal="0dp"
                android:text="Próxima Manutenção"
                app:layout_constraintTop_toBottomOf="@id/spinner_status" />

            <EditText
                android:id="@+id/edit_proxima_manut"
                style="@style/Edit_Text"
                android:layout_marginHorizontal="0dp"
                android:layout_marginBottom="16dp"
                android:drawableEnd="@drawable/ic_calendar"
                android:hint="dd/mm/aaaa"
                android:inputType="number"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/label_proxima_manut" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_salvar_equipamento"
            style="@style/ButtonCustom"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="40dp"
            android:text="Salvar Equipamento"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/containerForm" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
